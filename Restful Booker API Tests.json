        {
            "name": "03. Booking - Create",
            "item": [
                {
                    "name": "Booking - Create",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Подготовка данных",
                                    "const requestBody = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                                    "const response = pm.response.json();",
                                    "",
                                    "// Проверяем статус ответа",
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "// Проверяем структуру ответа",
                                    "pm.test(\"Booking ID is present\", function () {",
                                    "    pm.expect(response.bookingid).to.be.a(\"number\").and.above(0);",
                                    "});",
                                    "",
                                    "pm.test(\"Booking object is present\", function () {",
                                    "    pm.expect(response).to.have.property(\"booking\");",
                                    "    pm.expect(response.booking).to.be.an(\"object\");",
                                    "});",
                                    "",
                                    "// Проверяем, что поля ответа совпадают с телом запроса",
                                    "pm.test(\"Firstname matches request\", function () {",
                                    "    pm.expect(response.booking.firstname).to.eql(requestBody.firstname);",
                                    "});",
                                    "",
                                    "pm.test(\"Lastname matches request\", function () {",
                                    "    pm.expect(response.booking.lastname).to.eql(requestBody.lastname);",
                                    "});",
                                    "",
                                    "pm.test(\"Totalprice matches request\", function () {",
                                    "    pm.expect(response.booking.totalprice).to.eql(requestBody.totalprice);",
                                    "});",
                                    "",
                                    "pm.test(\"Depositpaid matches request\", function () {",
                                    "    pm.expect(response.booking.depositpaid).to.eql(requestBody.depositpaid);",
                                    "});",
                                    "",
                                    "pm.test(\"Checkin matches request\", function () {",
                                    "    pm.expect(response.booking.bookingdates.checkin)",
                                    "        .to.eql(requestBody.bookingdates.checkin);",
                                    "});",
                                    "",
                                    "pm.test(\"Checkout matches request\", function () {",
                                    "    pm.expect(response.booking.bookingdates.checkout)",
                                    "        .to.eql(requestBody.bookingdates.checkout);",
                                    "});",
                                    "",
                                    "pm.test(\"Additionalneeds matches request\", function () {",
                                    "    pm.expect(response.booking.additionalneeds)",
                                    "        .to.eql(requestBody.additionalneeds);",
                                    "});",
                                    "",
                                    "// Сохраняем данные для следующих запросов",
                                    "pm.collectionVariables.set(\"bookingId\", response.bookingid);",
                                    "pm.collectionVariables.set(\"bookingData\", JSON.stringify(requestBody));"
                                ]
                            }
                        }
                    ],
